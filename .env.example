# Example environment variables for frontBet
# Monetary values are expressed in centavos (inteiros)

# URL base do backend — usada por `app/config/env.ts` e pelo SDK
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Deposits (valores em centavos)
NEXT_PUBLIC_MIN_DEPOSIT=1000        # mínimo: R$ 10,00
NEXT_PUBLIC_MAX_DEPOSIT=1500000     # máximo: R$ 15.000,00

# Saques (valores em centavos)
NEXT_PUBLIC_MIN_WITHDRAWAL=2000     # mínimo: R$ 20,00
NEXT_PUBLIC_MAX_WITHDRAWAL=1000000  # máximo: R$ 10.000,00

# Rate limiter do formulário de contato (frontend)
NEXT_PUBLIC_CONTACT_RATE_MAX=3
NEXT_PUBLIC_CONTACT_RATE_WINDOW_MS=60000

# Outras variáveis úteis (opcionais):
# NODE_ENV=development
# TEST_REFRESH_TOKEN=token-for-local-tests
